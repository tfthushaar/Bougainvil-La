# Copy this file to .env.local and fill in the values from manage.sanity.io
# once the Sanity project exists (see README / CMS setup notes).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Only needed for the one-time content migration script
# (scripts/migrate-content-to-sanity.mjs) — generate at manage.sanity.io ->
# API -> Tokens (Editor permissions). Never used at request time.
SANITY_API_WRITE_TOKEN=

# Server-only (never sent to the browser). Lets the Presentation tool's
# preview session read draft/unpublished content and lets the draft-mode
# enable route validate preview requests. Generate at manage.sanity.io ->
# API -> Tokens (Viewer permissions) — must also be set in Netlify's
# environment variables (server-side, not NEXT_PUBLIC_) for it to work in
# production, since it's read at request time, not just build time.
SANITY_API_READ_TOKEN=
