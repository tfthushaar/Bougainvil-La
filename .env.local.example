# Copy this file to .env.local and fill in the values from manage.sanity.io
# once the Sanity project exists (see README / CMS setup notes).

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Only needed for the one-time image migration script
# (scripts/migrate-images-to-sanity.mjs) and the Studio's "manage" API calls —
# generate at manage.sanity.io -> API -> Tokens (Editor permissions).
SANITY_API_WRITE_TOKEN=
