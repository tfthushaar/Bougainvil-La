NEXT_PUBLIC_SITE_URL=https://bougainvilla.co.in

# Content is read from the database, both at build time and per-request on
# the deployed Cloudflare Worker (see lib/db/client.ts for why). Also needs
# to be set as a GitHub Actions secret (CI builds) and as a Cloudflare
# Worker secret (`wrangler secret put DATABASE_URL`) for production.
# Same Netlify DB (Neon) connection string used by ../admin.
DATABASE_URL=
