NEXT_PUBLIC_SITE_URL=https://bougainvilla.co.in

# Content is read from the database, both at build time and per-request on
# the deployed Cloudflare Worker (see lib/db/client.ts for why). Also needs
# to be set as GitHub Actions secrets (CI builds) and as Cloudflare Worker
# secrets (`wrangler secret put TURSO_DATABASE_URL` / `TURSO_AUTH_TOKEN`)
# for production. Same Turso database used by ../admin.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
