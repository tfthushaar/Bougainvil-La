# Copy to .env.local. See ../docs/netlify-admin-plan.md for how to provision these.

# Netlify DB (Neon Postgres) connection string — from Netlify dashboard →
# this site → Extensions/Database, once enabled.
DATABASE_URL=

# Auth.js session secret — any random 32+ byte string, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# @netlify/blobs needs no env vars when actually deployed on Netlify (it
# reads credentials from the Netlify runtime context automatically). Local
# `npm run dev` image uploads only work when run via `netlify dev` instead,
# which injects that same context.
